{
  "name": "documind",
  "version": "0.0.1",
  "private": true,
  "description": "AI-Powered Knowledge Management & Document Assistant",
  "scripts": {
    "dev": "docker-compose up --build",
    "simulate:load": "tsx scripts/simulate-load.ts",
    "dev:frontend": "pnpm --filter @documind/frontend dev",
    "dev:bff": "pnpm --filter @documind/bff dev",
    "dev:backend": "pnpm --filter @documind/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/form-data": "^2.5.2",
    "axios": "^1.21.1",
    "form-data": "^4.0.6",
    "tsx": "^4.23.15"
  }
}
